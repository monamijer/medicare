extends ../../layouts/base
include ../../partials/patient-fields

block content
  .page-header
    h1 Mon profil
  if errors.form
    .alert.alert-danger(role='alert')
      span.alert-text= errors.form
  form.form(method='post', action='/profile', data-loading-text='Enregistrement…')
    +patientFields(values, errors, 'edit')
    .form-actions
      button.btn.btn-primary(type='submit') Enregistrer
