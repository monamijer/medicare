extends ../../layouts/base

block content
  include ../../partials/icon
  .page-header
    h1 #{doctor.user.firstName} #{doctor.user.lastName}
    .table-actions
      a.btn.btn-secondary(href=`/availability?doctor=${doctor._id}`)
        +icon('clock')
        span Disponibilités
      a.btn.btn-secondary(href=`/doctors/${doctor._id}/edit`)
        +icon('pencil')
        span Modifier
  if doctor.user.active === false
    .alert.alert-info(role='status')
      span.alert-text Ce compte est désactivé : connexion impossible, historique de rendez-vous conservé.
      form(method='post', action=`/doctors/${doctor._id}/reactivate`)
        button.btn.btn-secondary.btn-sm(type='submit') Réactiver
  dl.details
    dt Spécialité
    dd= doctor.specialty.name
    dt Adresse e-mail
    dd= doctor.user.email
    dt Téléphone
    dd= doctor.phone || '-'
    dt Numéro de licence
    dd= doctor.licenseNumber
  p
    a(href='/doctors') Retour à la liste des médecins
