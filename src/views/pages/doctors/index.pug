extends ../../layouts/base

block content
  include ../../partials/icon
  .page-header
    h1 Médecins
    a.btn.btn-primary(href='/doctors/new')
      +icon('plus')
      span Nouveau médecin
  if doctors.length
    .table-wrap
      table.table
        thead
          tr
            th(scope='col') Nom
            th(scope='col') Spécialité
            th(scope='col') E-mail
            th(scope='col') Téléphone
            th.col-actions(scope='col') Actions
        tbody
          each doctor in doctors
            tr
              td
                a(href=`/doctors/${doctor._id}`) #{doctor.user.firstName} #{doctor.user.lastName}
              td= doctor.specialty.name
              td= doctor.user.email
              td= doctor.phone || '-'
              td.col-actions
                .table-actions
                  a.btn.btn-secondary.btn-sm(href=`/doctors/${doctor._id}/edit`)
                    +icon('pencil')
                    span Modifier
                  form(method='post', action=`/doctors/${doctor._id}/delete`, data-confirm=`Supprimer ${doctor.user.firstName} ${doctor.user.lastName} ? Son compte sera supprimé. Cette action est définitive.`, data-confirm-title='Supprimer le médecin', data-confirm-label='Supprimer')
                    button.btn.btn-danger.btn-sm(type='submit')
                      +icon('trash-2')
                      span Supprimer
  else
    .empty-state
      h2 Aucun médecin
      p Ajoutez un premier médecin pour pouvoir définir ses disponibilités.
      a.btn.btn-primary(href='/doctors/new')
        +icon('plus')
        span Nouveau médecin
