extends ../../layouts/base
include ../../partials/patient-fields

block content
  .page-header
    h1= patient ? 'Modifier le patient' : 'Nouveau patient'
  if errors.form
    .alert.alert-danger(role='alert')
      span.alert-text= errors.form
  form.form(method='post', action=patient ? `/patients/${patient._id}` : '/patients', data-loading-text='Enregistrement…')
    +patientFields(values, errors, patient ? 'edit' : 'create')
    .form-actions
      button.btn.btn-primary(type='submit') Enregistrer
      a.btn.btn-secondary(href=patient ? `/patients/${patient._id}` : '/patients') Annuler
